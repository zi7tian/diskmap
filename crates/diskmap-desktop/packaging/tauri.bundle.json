{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "category": "Utility",
    "shortDescription": "Disk usage map / 磁盘空间占用图",
    "longDescription": "Explore disk usage with nested rectangles colored by importance. Includes diskmap-cli and an MCP server.\n用嵌套方框查看磁盘占用，按重要程度着色，附带 diskmap-cli 和 MCP 服务。",
    "externalBin": ["../../target/packaging/sidecars/diskmap-cli"],
    "resources": { "../../LICENSE": "LICENSE" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "packaging/diskmap.desktop.hbs"
      }
    }
  }
}
